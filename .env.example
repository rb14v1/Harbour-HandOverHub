# ─── Harbour SSO / OIDC ─────────────────────────────────────────────────────
# These values must be set in the deployment environment.
# Never commit actual secrets — use a secrets manager or CI/CD secret store.

OIDC_ISSUER=https://your-issuer.example.com
OIDC_CLIENT_ID=your-client-id
OIDC_CLIENT_SECRET=your-client-secret
# Backend (Django) - copy to backend/.env and fill in values
DJANGO_SECRET_KEY=
DJANGO_DEBUG=
DJANGO_ALLOWED_HOSTS=
CORS_ALLOWED_ORIGINS=
SQLITE_PATH=
MONGODB_URI=
MONGODB_DB=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_VERSION=
AZURE_OPENAI_DEPLOYMENT=
